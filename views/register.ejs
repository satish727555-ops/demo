        stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 3l18 18"/>
        <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/>
        <path d="M9.9 5.2A11 11 0 0 1 12 5c6.4 0 10 7 10 7a15 15 0 0 1-3 3.8"/>
        <path d="M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10 10 0 0 0 3.2-.5"/>
        </svg>`;

        eye.setAttribute("aria-label", "Hide password");
        eye.title = "Hide password";

    } else {
        password.type = "password";

        eye.innerHTML = `
        <svg width="20" height="20" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/>
        <circle cx="12" cy="12" r="3"/>
        </svg>`;

        eye.setAttribute("aria-label", "Show password");
        eye.title = "Show password";
    }
};

/* PHONE VALIDATION */

$("phone").oninput = () => {
    $("phone").value = $("phone").value
        .replace(/\D/g,"")
        .slice(0,10);
};

/* OTP INPUT */

$("otp").oninput = () => {
    $("otp").value = $("otp").value
        .replace(/\D/g,"")
        .slice(0,6);
};

/* REGISTER STUDENT */

$("registerBtn").onclick = async () => {

    const data = {

        name: val("username"),
        email: val("email"),
        password: $("password").value,
        rollNo: val("rollNo"),
        phone: val("phone"),
        semester: val("semester"),
        course: val("course"),
        college: val("college"),
        university: val("university"),
        dateOfBirth: val("dateOfBirth"),
        address: val("address")

    };

    if(
        !data.name ||
        !data.email ||
        !data.password ||
        !data.rollNo ||
        !data.phone ||
        !data.semester ||
        !data.course ||
        !data.college ||
        !data.university
    ){
        return showMessage(
            $("registerMsg"),
            "Please fill all required fields.",
            "error"
        );
    }

    if(data.password.length < 8){
        return showMessage(
            $("registerMsg"),
            "Password must contain at least 8 characters.",
            "error"
        );
    }

    if(!/^[6-9]\d{9}$/.test(data.phone)){
        return showMessage(
            $("registerMsg"),
            "Enter a valid 10-digit Indian mobile number.",
            "error"
        );
    }

    const btn = $("registerBtn");

    btn.disabled = true;
    btn.textContent = "Creating Account...";

    try{

        const response = await fetch("/api/users/register",{
            method:"POST",
            headers:{
                "Content-Type":"application/json"
            },
            body:JSON.stringify(data)
        });

        const result = await response.json();

        if(!response.ok){
            throw new Error(result.message || "Registration failed.");
        }

        userEmail = data.email;

        $("otpEmail").textContent = userEmail;

        $("registerSection").style.display = "none";
        $("otpSection").style.display = "block";

        showMessage(
            $("otpMsg"),
            result.message || "OTP sent successfully.",
            "success"
        );

    }catch(error){

        showMessage(
            $("registerMsg"),
            error.message,
            "error"
        );

    }finally{

        btn.disabled = false;
        btn.textContent = "Create Student Account";

    }

};

/* VERIFY OTP */

$("verifyBtn").onclick = async () => {

    const code = val("otp");

    if(code.length !== 6){
        return showMessage(
            $("otpMsg"),
            "Please enter a valid 6-digit OTP.",
            "error"
        );
    }

    const btn = $("verifyBtn");

    btn.disabled = true;
    btn.textContent = "Verifying...";

    try{

        const response = await fetch("/api/users/verify-otp",{
            method:"POST",
            headers:{
                "Content-Type":"application/json"
            },
            body:JSON.stringify({
                email:userEmail,
                otp:code
            })
        });

        const result = await response.json();

        if(!response.ok){
            throw new Error(result.message || "Verification failed.");
        }

        showMessage(
            $("otpMsg"),
            result.message || "Email verified successfully.",
            "success"
        );

        btn.textContent = "Verified âœ“";

        setTimeout(() => {
            location.href = "/api/users/login";
        },1200);

    }catch(error){

        showMessage(
            $("otpMsg"),
            error.message,
            "error"
        );

        btn.disabled = false;
        btn.textContent = "Verify Email";

    }

};

/* RESEND OTP */

$("resendBtn").onclick = async () => {

    if(!userEmail){
        return showMessage(
            $("otpMsg"),
            "Email not found. Please register again.",
            "error"
        );
    }

    const btn = $("resendBtn");

    btn.disabled = true;
    btn.textContent = "Sending...";

    try{

        const response = await fetch("/api/users/resend-otp",{
            method:"POST",
            headers:{
                "Content-Type":"application/json"
            },
            body:JSON.stringify({
                email:userEmail
            })
        });

        const result = await response.json();

        if(!response.ok){
            throw new Error(result.message || "Unable to resend OTP.");
        }

        showMessage(
            $("otpMsg"),
            result.message || "OTP sent successfully.",
            "success"
        );

    }catch(error){

        showMessage(
            $("otpMsg"),
            error.message,
            "error"
        );

    }finally{

        btn.disabled = false;
        btn.textContent = "â†» Resend OTP";

    }

};

/* BACK BUTTON */

$("backBtn").onclick = () => {

    $("otpSection").style.display = "none";
    $("registerSection").style.display = "block";

    $("otp").value = "";
    $("otpMsg").className = "msg";

};

</script>

</body>
</html>


















