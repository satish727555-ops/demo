<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EduNexus | Smart Student Management System</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
--primary:#2563eb;
--secondary:#7c3aed;
--text:#0f172a;
--muted:#64748b;
--border:#e2e8f0;
--danger:#dc2626;
--success:#059669;
}

body{
min-height:100vh;
font-family:Inter,Arial,sans-serif;
background:
radial-gradient(circle at 10% 10%,rgba(37,99,235,.18),transparent 30%),
radial-gradient(circle at 90% 90%,rgba(124,58,237,.18),transparent 30%),
#f8fafc;
color:var(--text);
padding:35px 15px;
}

.container{width:min(100%,760px);margin:auto}

.brand{text-align:center;margin-bottom:25px}

.brand img{
width:min(100%,560px);
height:auto;
object-fit:contain;
display:block;
margin:auto;
}

.card{
background:rgba(255,255,255,.96);
border:1px solid var(--border);
border-radius:22px;
padding:32px;
box-shadow:0 25px 60px rgba(15,23,42,.10);
}

.topbar{
display:flex;
justify-content:space-between;
align-items:center;
padding-bottom:20px;
border-bottom:1px solid var(--border);
margin-bottom:22px;
}

.topbar-title{font-size:17px;font-weight:700}

.secure{
font-size:11px;
color:var(--success);
background:#ecfdf5;
padding:7px 10px;
border-radius:20px;
}

.section{margin:24px 0 15px}

.section-title{
font-size:14px;
font-weight:800;
color:#1e40af;
margin-bottom:5px;
}

.section-line{
height:2px;
width:35px;
background:linear-gradient(90deg,var(--primary),var(--secondary));
border-radius:10px;
margin-bottom:5px;
}

.section-subtitle{font-size:11px;color:var(--muted)}

.grid{
display:grid;
grid-template-columns:repeat(2,minmax(0,1fr));
gap:16px;
}

.full{grid-column:1/-1}
.group{margin-bottom:2px}

label{
display:block;
font-size:12px;
font-weight:700;
color:#334155;
margin-bottom:7px;
}

.required{color:var(--danger)}

input,select,textarea{
width:100%;
border:1px solid var(--border);
background:#f8fafc;
color:var(--text);
border-radius:11px;
font-size:13px;
outline:none;
transition:.2s;
}

input,select{height:46px;padding:0 13px}
textarea{min-height:90px;padding:12px 13px;resize:vertical}

input:focus,select:focus,textarea:focus{
background:white;
border-color:var(--primary);
box-shadow:0 0 0 4px rgba(37,99,235,.08);
}

input[readonly]{background:#f1f5f9;color:#475569}

.password-box{position:relative}
.password-box input{padding-right:45px}

.eye{
position:absolute;
right:8px;
top:6px;
width:34px;
height:34px;
border:none;
background:transparent;
color:#64748b;
cursor:pointer;
border-radius:8px;
display:flex;
align-items:center;
justify-content:center;
transition:all .2s ease;
}
.eye:hover{
color:#2563eb;
background:#eff6ff;
}
.eye:focus-visible{
outline:2px solid #2563eb;
outline-offset:2px;
}
.eye svg{
width:20px;
height:20px;
}

.btn{
width:100%;
height:48px;
margin-top:22px;
border:none;
border-radius:11px;
color:white;
font-size:13px;
font-weight:800;
cursor:pointer;
background:linear-gradient(135deg,#2563eb,#4f46e5,#7c3aed);
box-shadow:0 10px 22px rgba(37,99,235,.20);
}

.btn:disabled{opacity:.6;cursor:not-allowed}

.msg{
display:none;
margin-top:12px;
padding:10px 12px;
border-radius:9px;
font-size:12px;
text-align:center;
}

.msg.show{display:block}
.success{background:#ecfdf5;color:#047857;border:1px solid #a7f3d0}
.error{background:#fef2f2;color:#b91c1c;border:1px solid #fecaca}

.login{
text-align:center;
margin-top:18px;
font-size:12px;
color:var(--muted);
}

.login a{
color:var(--primary);
font-weight:800;
text-decoration:none;
}

.footer{
text-align:center;
margin-top:20px;
color:#94a3b8;
font-size:10px;
}

#otpSection{display:none;text-align:center}

.otp-icon{
width:70px;
height:70px;
margin:5px auto 18px;
display:grid;
place-items:center;
border-radius:20px;
background:linear-gradient(135deg,#dbeafe,#ede9fe);
font-size:30px;
}

.otp-title{font-size:24px;font-weight:800;margin-bottom:7px}

.otp-sub{
color:var(--muted);
font-size:12px;
line-height:1.7;
margin-bottom:22px;
}

.otp-email{color:var(--primary);font-weight:800}

.otp-input{
text-align:center;
font-size:25px!important;
font-weight:800;
letter-spacing:8px;
}

.otp-actions{
display:grid;
grid-template-columns:1fr 1fr;
gap:10px;
margin-top:12px;
}

.secondary-btn{
height:43px;
border:1px solid var(--border);
border-radius:10px;
background:white;
color:#334155;
font-size:12px;
font-weight:700;
cursor:pointer;
}

.resend{color:var(--primary);border-color:#bfdbfe}

@media(max-width:650px){
body{padding:20px 12px}
.card{padding:22px 17px;border-radius:18px}
.grid{grid-template-columns:1fr}
.full{grid-column:auto}
.brand img{width:100%}
.topbar{align-items:flex-start;gap:10px}
.secure{font-size:9px}
}

@media(max-width:420px){
.otp-actions{grid-template-columns:1fr}
.otp-input{font-size:22px!important}
}

