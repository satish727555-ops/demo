<script>

const $ = id => document.getElementById(id);

let userEmail = "";

const val = id => $(id).value.trim();

/* ================= DYNAMIC SEMESTER ================= */

const courseDuration = {
    "BCA": 6,
    "M.Tech": 4,
    "BA": 6,
    "MA": 4,
    "B.Com": 6,
    "M.Com": 4,
    "B.Ed": 4,
    "LLB": 6,
    "LLM": 4,
    "B.Pharm": 8,
